# Sitenin gerçek adresi. Canonical bağlantılar, sitemap ve paylaşım görselleri bundan üretilir.
NEXT_PUBLIC_SITE_URL=https://nebuchadnezzar-three.vercel.app

# Veri kaynağı: "seed" (varsayılan, data/seed/*.json) veya "supabase"
DATA_SOURCE=seed

# Yalnızca DATA_SOURCE=supabase için (uygulama okuma erişimi)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Yalnızca npm run data:load-supabase için. Bu anahtar RLS'yi aşar:
# tarayıcıya gitmemeli, NEXT_PUBLIC_ önekiyle tanımlanmamalı.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
